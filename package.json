{
  "name": "retiro-interactivo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Mapa digital mobile first del Parque del Retiro (Fase 1)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate:data && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit && vitest run",
    "validate:data": "node scripts/validate-places.mjs",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx,astro}\" --max-warnings=0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.1.6",
    "maplibre-gl": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
