{
  "name": "retiro-interactivo",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "description": "Mapa digital mobile first del Parque del Retiro (Fase 2B)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate:data && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit && vitest run",
    "validate:data": "node scripts/validate-places.mjs",
    "services:osm": "node scripts/services-osm.mjs",
    "test": "vitest run",
    "test:e2e": "node e2e/prepare.mjs && playwright test",
    "lint": "eslint \"src/**/*.{ts,tsx,astro}\" --max-warnings=0",
    "format": "prettier --write .",
    "events:collect": "node scripts/events-collect.mjs",
    "events:normalize": "node scripts/events-normalize.mjs",
    "events:validate": "node scripts/events-validate.mjs",
    "events:build": "node scripts/events-build.mjs",
    "events:report": "node scripts/events-report.mjs",
    "routes:validate": "node scripts/routes-validate.mjs",
    "routes:paths": "node scripts/routes-build-paths.mjs",
    "content:report": "node scripts/content-report.mjs",
    "events:guard": "node scripts/events-refresh-guard.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.1.6",
    "maplibre-gl": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.55.1",
    "@types/node": "^26.1.2",
    "@vite-pwa/astro": "^1.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
