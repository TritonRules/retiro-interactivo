---
import '../styles/global.css';
import { siteConfig } from '../config/site';

const title = Astro.props.title ?? siteConfig.name;
const description = Astro.props.description ?? siteConfig.description;
const canonicalPath = Astro.props.canonicalPath ?? '/';
const bodyClass = Astro.props.bodyClass ?? '';
const robots = Astro.props.robots;

const pageTitle =
  title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;

const canonicalURL = new URL(
  `${import.meta.env.BASE_URL}${canonicalPath.replace(/^\//, '')}`.replace(
    /\/{2,}/g,
    '/',
  ),
  Astro.site,
);
---

<!doctype html>
<html lang="es-ES">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {robots ? <meta name="robots" content={robots} /> : null}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1B5E3B" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Retiro" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link
      rel="apple-touch-icon"
      href={`${import.meta.env.BASE_URL}icons/icon-192.png`}
    />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />
    <link rel="preconnect" href="https://tiles.openfreemap.org" crossorigin />
    <title>{pageTitle}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido</a>
    <div class="app-shell">
      <header class="site-header">
        <a class="site-header__brand" href={import.meta.env.BASE_URL}>
          <span class="site-header__name">{siteConfig.name}</span>
          <span class="site-header__tagline">{siteConfig.tagline}</span>
        </a>
        <nav class="site-header__nav" aria-label="Principal">
          <a
            class="site-header__link"
            href={import.meta.env.BASE_URL}
            aria-current={canonicalPath === '/' ? 'page' : undefined}
          >
            Mapa
          </a>
          <a
            class="site-header__link"
            href={`${import.meta.env.BASE_URL}rutas/`}
            aria-current={canonicalPath.startsWith('/rutas') ? 'page' : undefined}
          >
            Rutas
          </a>
          <a
            class="site-header__link"
            href={`${import.meta.env.BASE_URL}agenda/`}
            aria-current={canonicalPath.startsWith('/agenda') ? 'page' : undefined}
          >
            Agenda
          </a>
          <a
            class="site-header__link"
            href={`${import.meta.env.BASE_URL}acerca-de/`}
            aria-current={canonicalPath.startsWith('/acerca-de') ? 'page' : undefined}
          >
            Acerca
          </a>
        </nav>
      </header>
      <main id="contenido-principal" class="main-content">
        <slot />
      </main>
      <footer class="site-footer">
        <p>
          {siteConfig.name} · {siteConfig.phase}. Cartografía:
          OpenStreetMap · OpenFreeMap · MapLibre.
        </p>
      </footer>
    </div>

    <div id="pwa-update" class="pwa-update" hidden role="status" aria-live="polite">
      <span>Hay una nueva versión disponible.</span>
      <button type="button" id="pwa-update-btn">Actualizar</button>
    </div>

    <script>
      import { registerSW } from 'virtual:pwa-register';

      const banner = document.getElementById('pwa-update');
      const button = document.getElementById('pwa-update-btn');

      const updateSW = registerSW({
        immediate: true,
        onNeedRefresh() {
          if (banner) banner.hidden = false;
        },
        onOfflineReady() {
          // Silencioso: la shell ya está lista offline.
        },
      });

      button?.addEventListener('click', () => {
        updateSW(true);
      });
    </script>
  </body>
</html>
