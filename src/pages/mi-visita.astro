---
import BaseLayout from '../layouts/BaseLayout.astro';
import MiVisita from '../components/visit/MiVisita';
import { places } from '../utils/places';
import { services } from '../utils/services';
import { routes } from '../utils/routes';
import { buildVisitCatalog } from '../utils/visitCatalog';
import { buildVisitPresets } from '../utils/visitPresets';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const catalog = buildVisitCatalog(base);
const presets = buildVisitPresets(places, services, routes);
---

<BaseLayout
  title="Mi visita"
  description="Tus lugares guardados del Retiro y una ruta a pie hecha a tu medida."
  canonicalPath="/mi-visita/"
>
  <article class="page">
    <h1>Mi visita</h1>
    <p>Guarda lugares, estatuas y servicios y crea tu propia ruta a pie por el Retiro.</p>
    <MiVisita client:only="react" catalog={catalog} presets={presets} baseUrl={base} />
  </article>
</BaseLayout>
