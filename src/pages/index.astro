---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapExplorer from '../components/map/MapExplorer';
import { places } from '../utils/places';
import { services } from '../utils/services';
import { routes } from '../utils/routes';
import { getUpcomingEvents } from '../utils/events';
import { siteConfig } from '../config/site';

const focusSlug = Astro.url.searchParams.get('lugar') ?? undefined;
const initialCategory = Astro.url.searchParams.get('categoria') ?? undefined;
const initialRoute = Astro.url.searchParams.get('ruta') ?? undefined;
const initialEvent = Astro.url.searchParams.get('evento') ?? undefined;

const mapEvents = [];
for (const event of getUpcomingEvents()) {
  if (!event.coordinates) continue;
  mapEvents.push({
    id: event.id,
    slug: event.slug,
    title: event.title,
    coordinates: event.coordinates,
    startAt: event.startAt,
    venue: event.venue,
  });
}
---

<BaseLayout
  title={siteConfig.name}
  description={siteConfig.description}
  canonicalPath="/"
>
  <div class="map-page">
    <h1 class="sr-only">{siteConfig.name}: mapa del Parque del Retiro</h1>
    <MapExplorer
      client:only="react"
      places={places}
      services={services}
      routes={routes}
      events={mapEvents}
      baseUrl={import.meta.env.BASE_URL}
      initialCategory={initialCategory}
      focusSlug={focusSlug}
      initialRouteSlug={initialRoute}
      initialEventSlug={initialEvent}
    />
  </div>
</BaseLayout>
