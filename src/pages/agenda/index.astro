---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AgendaExplorer from '../../components/agenda/AgendaExplorer';
import { events } from '../../utils/events';
import { eventDetailPath } from '../../utils/eventLinks';
import { formatMadridDateTime } from '../../utils/datetime';
import { siteConfig } from '../../config/site';

const base = import.meta.env.BASE_URL;
const generatedAt = new Date().toISOString();
const staticList = [...events]
  .filter((event) => event.status === 'published' || event.status === 'expired')
  .sort((a, b) => Date.parse(a.startAt) - Date.parse(b.startAt));
---

<BaseLayout
  title="Agenda"
  description="Agenda de actividades oficiales relacionadas con el Parque del Retiro."
  canonicalPath="/agenda/"
>
  <div class="page">
    <header class="page-hero">
      <p class="eyebrow">Fuentes oficiales</p>
      <h1>Agenda del Retiro</h1>
      <p>
        Eventos publicados desde datasets municipales abiertos, filtrados al ámbito del parque.
        La agenda no es exhaustiva. Verifica siempre el enlace original.
      </p>
    </header>

    <AgendaExplorer client:load events={events} baseUrl={base} generatedAt={generatedAt} />

    <noscript>
      <p class="empty">
        JavaScript está desactivado. Estas fechas son las del archivo generado el {
          formatMadridDateTime(generatedAt, { dateStyle: 'long', timeStyle: 'short' })
        }
        y no un «Hoy» en tiempo real.
      </p>
      <ul class="card-list">
        {
          staticList.map((event) => (
            <li class="content-card">
              <h3>
                <a href={`${base}${eventDetailPath(event.slug)}`}>{event.title}</a>
              </h3>
              <p class="meta">
                {event.startAt.includes('T00:00:00')
                  ? formatMadridDateTime(event.startAt, { dateStyle: 'medium' })
                  : formatMadridDateTime(event.startAt, { dateStyle: 'medium', timeStyle: 'short' })} · {event.venue}
              </p>
            </li>
          ))
        }
      </ul>
    </noscript>

    <p class="footnote">
      Atribución: Ayuntamiento de Madrid (datos abiertos, CC BY 4.0). {siteConfig.name} no inventa
      horarios ni precios.
    </p>
  </div>
</BaseLayout>

<style>
  .eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-ink-muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .block {
    margin-bottom: var(--space-8);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    align-items: end;
  }
  .filters label {
    display: grid;
    gap: var(--space-1);
    font-size: 0.9rem;
  }
  .filters select,
  .filters input {
    min-height: var(--touch-min);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }
  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .content-card {
    padding: var(--space-4);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .content-card h3 {
    margin: 0 0 var(--space-2);
    font-size: 1.1rem;
  }
  .meta {
    color: var(--color-ink-muted);
    font-size: 0.9rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .empty {
    padding: var(--space-4);
    background: var(--color-primary-soft);
    border-radius: var(--radius-md);
  }
  .footnote {
    color: var(--color-ink-muted);
    font-size: 0.9rem;
  }
  .agenda-count,
  .agenda-freshness {
    color: var(--color-ink-muted);
    font-size: 0.95rem;
  }
</style>
